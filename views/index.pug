extends layout

block content
  main.home
    header.home__header
      h1.home__title Hobby projects
      p.home__byline
        | by
        =' '
        a.home__author(href="https://www.danielbeardsley.com") Daniel Beardsley
    section.home__section
      h2.home__section-title Tools
      ul.home__projects
        li.home__project
          a.home__link(href="/timeseries")
            span.home__link-title Time Series
            span.home__link-desc Store and view named series of timestamped values.
        li.home__project
          a.home__link(href="/experiments/auto-financing-comparison/index.html")
            span.home__link-title Buy-vs-Finance Car Comparison
            span.home__link-desc Compare paying cash for a car against financing and investing the difference.
        li.home__project
          a.home__link(href="https://danielbeardsley.github.io/electric-car-purchase/")
            span.home__link-title Should I buy an EV?
            span.home__link-desc Compare the cost of keeping a gas car against switching to an electric one.
    section.home__section
      h2.home__section-title Games & Toys
      ul.home__projects
        li.home__project
          a.home__link(href="https://danielbeardsley.github.io/psnake/")
            span.home__link-title psnake
            span.home__link-desc Snake-like game for two players
        li.home__project
          a.home__link(href="https://danielbeardsley.github.io/floatloops/")
            span.home__link-title floatloops
            span.home__link-desc Loop-based audio sequencer that runs in the browser
        li.home__project
          a.home__link(href="https://danielbeardsley.github.io/spell-invaders/")
            span.home__link-title spell-invaders
            span.home__link-desc A typing-practice arcade game
